{
  "manifest_version": 3,
  "name": "Category Sift",
  "version": "0.1.1",
  "description": "Filter listing categories on Trade Me search pages.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.trademe.co.nz/*"],
  "content_scripts": [
    {
      "matches": ["https://www.trademe.co.nz/a/*"],
      "js": ["src/filter-core.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
